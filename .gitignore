# Binaries for programs and plugins
*.exe
*.exe~
*.dll
*.so
*.dylib

# Test binary, built with `go test -c`
*.test

# Code coverage profiles and other test artifacts
*.out
coverage
coverage.*
*.coverprofile
profile.cov

# Go workspace file
go.work
go.work.sum

# Local config overrides (may contain secrets — never commit)
config.yaml
config.yml

# Env files
.env
.env.*

# direnv
.direnv/
.envrc

# Editor/IDE & OS
.DS_Store

# Keys/certs
*.pem

# Legacy package-manager caches (pre-migration leftovers)
node_modules
.pnpm-store
