{
  "name": "${localWorkspaceFolderBasename} — Nix Dev Environment",
  "build": {
    "context": ".",
    "dockerfile": "Dockerfile",
    "args": {
      "PRETTY_HOSTNAME": "${localWorkspaceFolderBasename} Repo"
    }
  },

  "workspaceFolder": "/workspace",
  "workspaceMount": "source=${localWorkspaceFolder},target=/workspace,type=bind,consistency=cached",

  "mounts": ["source=/mnt/user-home,target=/mnt/user-home,type=bind", "source=lunarhue-containers-nix-store,target=/nix,type=volume"],
  "runArgs": ["--tmpfs", "/mnt/user-home/codex/tmp:rw,exec,nosuid,nodev,mode=0700,uid=1000,gid=1000,size=64m"],
  "updateRemoteUserUID": false,

  "features": {
    "ghcr.io/devcontainers/features/common-utils:2": {
      "username": "vscode",
      "userUid": "1000",
      "userGid": "1000",
      "installZsh": false,
      "installOhMyZsh": false,
      "configureZshAsDefaultShell": false
    },
    "ghcr.io/devcontainers/features/docker-outside-of-docker:1": {
      "version": "latest",
      "enableNonRootDocker": "true",
      "moby": "false"
    }
  },
  // The Coder template supplies these; start.sh launches T3 Code when both are set.
  "remoteEnv": {
    "T3CODE_INSTANCE": "${localEnv:T3CODE_INSTANCE}",
    "T3CODE_RELAY_PRIVATE_URL": "${localEnv:T3CODE_RELAY_PRIVATE_URL}"
  },
  "containerEnv": {
    "CODEX_HOME": "/mnt/user-home/codex",
    "CLAUDE_CONFIG_DIR": "/mnt/user-home/claude",
    "T3CODE_HOME": "/mnt/user-home/t3code",
    "GH_CONFIG_DIR": "/mnt/user-home/gh"
  },

  "postCreateCommand": "bash .devcontainer/create.sh",
  "postStartCommand": "bash .devcontainer/start.sh",

  "customizations": {
    "vscode": {
      "extensions": ["mkhl.direnv", "jnoortheen.nix-ide", "golang.go"],
      "settings": {
        "go.useLanguageServer": true,
        "go.toolsManagement.checkForUpdates": "off",
        "go.toolsManagement.autoUpdate": false
      }
    }
  },

  "remoteUser": "vscode"
}
